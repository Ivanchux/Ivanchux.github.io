<!DOCTYPE retroterm [

  <!-- ══════════════════════════════════════════
       DEFINICIÓN DE ENTIDADES
       Abreviaturas reutilizables en el contenido
  ══════════════════════════════════════════ -->
  <!ENTITY autor "Iván Brihuega Crespo">
  <!ENTITY curso  "1.º ASIR — CDM 2025/26">
  <!ENTITY url    "https://ivanchux.github.io/">

  <!-- ══════════════════════════════════════════
       DEFINICIÓN DE ELEMENTOS (etiquetas)
  ══════════════════════════════════════════ -->

  <!-- Raíz del documento -->
  <!ELEMENT retroterm (proyecto, red, articulos)>

  <!-- ── Bloque PROYECTO ── -->
  <!ELEMENT proyecto (nombre, descripcion, autor, version, tecnologias)>
  <!ELEMENT nombre      (#PCDATA)>
  <!ELEMENT descripcion (#PCDATA)>
  <!ELEMENT autor       (#PCDATA)>
  <!ELEMENT version     (#PCDATA)>
  <!ELEMENT tecnologias (tecnologia+)>
  <!ELEMENT tecnologia  (#PCDATA)>

  <!-- ── Bloque RED ── -->
  <!ELEMENT red (miembro+)>
  <!ELEMENT miembro (nombre_miembro, url_proyecto, descripcion_proyecto)>
  <!ELEMENT nombre_miembro      (#PCDATA)>
  <!ELEMENT url_proyecto        (#PCDATA)>
  <!ELEMENT descripcion_proyecto (#PCDATA)>

  <!-- Atributo de miembro: rol es obligatorio y acotado -->
  <!ATTLIST miembro
    rol    (alumno|profesor)  #REQUIRED
    activo (si|no)            #IMPLIED
  >

  <!-- ── Bloque ARTICULOS ── -->
  <!ELEMENT articulos (articulo+)>
  <!ELEMENT articulo  (titulo, categoria, fecha, resumen)>
  <!ELEMENT titulo    (#PCDATA)>
  <!ELEMENT categoria (#PCDATA)>
  <!ELEMENT fecha     (#PCDATA)>
  <!ELEMENT resumen   (#PCDATA)>

  <!-- Atributos del artículo -->
  <!ATTLIST articulo
    id       NMTOKEN  #REQUIRED
    publicado (si|no) #IMPLIED
  >

]>

<!-- ══════════════════════════════════════════
     CONTENIDO XML
══════════════════════════════════════════ -->
